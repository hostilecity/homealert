<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "HomeAlert" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="HomeAlert">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-950 text-white">
    <% if notice.present? %>
      <div class="fixed top-4 right-4 z-50 px-4 py-3 rounded-xl bg-green-900/80 border border-green-700 text-green-200 text-sm shadow-lg">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="fixed top-4 right-4 z-50 px-4 py-3 rounded-xl bg-red-900/80 border border-red-700 text-red-200 text-sm shadow-lg">
        <%= alert %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
