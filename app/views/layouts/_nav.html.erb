<header class="border-b border-gray-800 bg-gray-900">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <%= link_to root_path, class: "flex items-center gap-2.5" do %>
      <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-600">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
        </svg>
      </div>
      <span class="font-semibold text-white tracking-tight">HomeAlert</span>
    <% end %>

    <!-- Nav links -->
    <nav class="flex items-center gap-1">
      <%= link_to "Dashboard", root_path,
            class: "px-3 py-1.5 rounded-lg text-sm font-medium transition #{controller_name == 'dashboard' ? 'text-white bg-gray-800' : 'text-gray-400 hover:text-white hover:bg-gray-800'}" %>
      <%= link_to "Settings", "#",
            class: "px-3 py-1.5 rounded-lg text-sm font-medium transition #{controller_name == 'settings' ? 'text-white bg-gray-800' : 'text-gray-400 hover:text-white hover:bg-gray-800'}" %>
    </nav>

    <!-- User avatar -->
    <div class="flex items-center gap-2">
      <% if current_user.avatar_url.present? %>
        <img src="<%= current_user.avatar_url %>" class="w-8 h-8 rounded-full" alt="<%= current_user.name %>" />
      <% else %>
        <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold text-white">
          <%= current_user.name.split.map(&:first).first(2).join.upcase %>
        </div>
      <% end %>
      <span class="text-sm text-gray-300 hidden sm:inline"><%= current_user.name %></span>
    </div>

  </div>
</header>
