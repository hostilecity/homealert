<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "HomeAlert" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="HomeAlert">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-950 text-white">
    <% if notice.present? %>
      <div data-controller="flash"
           class="fixed top-4 right-4 z-50 px-4 py-3 rounded-xl bg-green-900/80 border border-green-700 text-green-200 text-sm shadow-lg transition duration-300 ease-in-out">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div data-controller="flash"
           class="fixed top-4 right-4 z-50 px-4 py-3 rounded-xl bg-red-900/80 border border-red-700 text-red-200 text-sm shadow-lg transition duration-300 ease-in-out">
        <%= alert %>
      </div>
    <% end %>

    <!-- Minimal public header: logo + sign-in link only -->
    <header class="border-b border-gray-800 bg-gray-900">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center gap-2.5" do %>
          <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-600">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
          </div>
          <span class="font-semibold text-white tracking-tight">HomeAlert</span>
        <% end %>
        <%= link_to "Sign in", login_path, class: "text-sm text-gray-400 hover:text-white transition" %>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <%= yield %>
    </main>
  </body>
</html>
