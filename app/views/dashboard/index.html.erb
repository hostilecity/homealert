<% content_for :title, "Dashboard — HomeAlert" %>

<div class="space-y-8">

  <!-- Page heading -->
  <div>
    <h2 class="text-xl font-semibold">Dashboard</h2>
    <p class="mt-1 text-sm text-gray-400">Recent activity from your home security devices.</p>
  </div>

  <!-- Stat cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wider">Events today</p>
      <p class="mt-2 text-3xl font-bold"><%= @events_today_count %></p>
      <p class="mt-1 text-xs text-gray-500">Across all devices</p>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wider">Doorbell presses</p>
      <p class="mt-2 text-3xl font-bold text-indigo-400"><%= @doorbell_count %></p>
      <p class="mt-1 text-xs text-gray-500">
        <% if @last_doorbell %>
          Last: <%= time_ago_in_words(@last_doorbell.occurred_at) %> ago
        <% else %>
          No events today
        <% end %>
      </p>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wider">Motion events</p>
      <p class="mt-2 text-3xl font-bold text-amber-400"><%= @motion_count %></p>
      <p class="mt-1 text-xs text-gray-500">
        <% if @last_motion %>
          Last: <%= time_ago_in_words(@last_motion.occurred_at) %> ago
        <% else %>
          No events today
        <% end %>
      </p>
    </div>

  </div>

  <!-- Recent events feed -->
  <%
    newest_event       = @recent_events_by_date.values.first&.first
    oldest_event       = @recent_events_by_date.values.last&.last
    has_more           = @recent_events_by_date.values.sum(&:length) == 10
  %>
  <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden"
       data-controller="feed"
       data-feed-url-value="<%= events_feed_path %>"
       data-feed-newest-id-value="<%= newest_event&.id.to_i %>"
       data-feed-oldest-occurred-at-value="<%= oldest_event&.occurred_at&.iso8601 %>">

    <% if @recent_events_by_date.any? %>

      <!-- Prepend target: new events are injected here -->
      <div data-feed-target="list">
        <%= render "feed_rows",
                   events: @recent_events_by_date.values.flatten,
                   context: :initial,
                   last_date: nil %>
      </div>

      <!-- View more footer -->
      <div id="view-more-footer"
           class="px-5 py-3 border-t border-gray-800 text-center"
           data-feed-target="footer">
        <% if has_more %>
          <button class="text-xs text-indigo-400 hover:text-indigo-300 transition"
                  data-action="click->feed#loadMore">
            View more
          </button>
        <% end %>
      </div>

    <% else %>
      <div data-feed-target="list"></div>
      <div class="px-5 py-12 text-center" data-feed-target="empty">
        <p class="text-sm text-gray-500">No events yet. Events will appear here once your devices are connected.</p>
      </div>
      <!-- Footer target always present so polling can insert View more after first events arrive -->
      <div id="view-more-footer"
           class="hidden"
           data-feed-target="footer"></div>
    <% end %>

  </div>

</div>
