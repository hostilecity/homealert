<% doorbell = event.event_type == "doorbell_pressed" %>

<div class="flex items-center gap-4 px-5 py-4">

  <!-- Icon -->
  <div class="flex-shrink-0 w-9 h-9 rounded-xl flex items-center justify-center
              <%= doorbell ? 'bg-indigo-600/20' : 'bg-amber-600/20' %>">
    <% if doorbell %>
      <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" />
      </svg>
    <% else %>
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5 10.5 6.75 14.25 10.5l5.25-5.25M3.75 13.5H9m-5.25 0V7.5" />
      </svg>
    <% end %>
  </div>

  <!-- Label + device -->
  <div class="flex-1 min-w-0">
    <p class="text-sm font-medium text-white">
      <%= doorbell ? "Doorbell pressed" : "Motion detected" %>
    </p>
    <p class="text-xs text-gray-500 truncate"><%= event.device_name %></p>
  </div>

  <!-- Badge + time -->
  <div class="text-right flex-shrink-0">
    <% if doorbell %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-900/50 text-indigo-300">Doorbell</span>
    <% else %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-900/50 text-amber-300">Motion</span>
    <% end %>
    <p class="mt-1 text-xs text-gray-500"><%= event.occurred_at.in_time_zone.strftime("%-I:%M %p") %></p>
  </div>

</div>
