<%
  event_type = event.event_type
  doorbell   = event_type == "doorbell_pressed"
  motion     = event_type == "motion_detected"
  vpn        = event_type == "vpn_login"

  icon_bg    = doorbell ? "bg-indigo-600/20" : motion ? "bg-amber-600/20" : "bg-emerald-600/20"
  label      = doorbell ? "Doorbell pressed" : motion ? "Motion detected" : "VPN login"
  badge_css  = doorbell ? "bg-indigo-900/50 text-indigo-300" : motion ? "bg-amber-900/50 text-amber-300" : "bg-emerald-900/50 text-emerald-300"
  badge_text = doorbell ? "Doorbell" : motion ? "Motion" : "VPN"
%>

<div class="border-t border-gray-800"
     data-event-id="<%= event.id %>"
     data-event-date="<%= event.occurred_at.in_time_zone.to_date %>"
     data-event-occurred-at="<%= event.occurred_at.iso8601 %>"
     <% if event.snapshot.attached? %>data-controller="snapshot"<% end %>>

  <div class="flex items-center gap-4 px-5 py-4">

    <!-- Icon -->
    <div class="flex-shrink-0 w-9 h-9 rounded-xl flex items-center justify-center <%= icon_bg %>">
      <% if doorbell %>
        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" />
        </svg>
      <% elsif motion %>
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5 10.5 6.75 14.25 10.5l5.25-5.25M3.75 13.5H9m-5.25 0V7.5" />
        </svg>
      <% else %>
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
      <% end %>
    </div>

    <!-- Label + device -->
    <div class="flex-1 min-w-0">
      <p class="text-sm font-medium text-white"><%= label %></p>
      <p class="text-xs text-gray-500 truncate"><%= event.device_name %></p>

      <% if event.snapshot.attached? %>
        <button type="button"
                class="mt-1 inline-flex items-center gap-1 text-xs text-indigo-400 hover:text-indigo-300 transition"
                data-action="click->snapshot#toggle"
                data-snapshot-target="button">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          <span data-snapshot-target="label">Show snapshot</span>
        </button>
      <% end %>
    </div>

    <!-- Badge + time -->
    <div class="text-right flex-shrink-0">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= badge_css %>"><%= badge_text %></span>
      <p class="mt-1 text-xs text-gray-500"><%= event.occurred_at.in_time_zone.strftime("%-I:%M %p") %></p>
    </div>

  </div>

  <% if event.snapshot.attached? %>
    <div class="hidden px-5 pb-4" data-snapshot-target="panel">
      <img data-snapshot-target="image"
           data-src="<%= rails_blob_path(event.snapshot, disposition: "inline") %>"
           alt="Snapshot from <%= event.device_name %>"
           class="w-full max-w-sm rounded-lg border border-gray-800" />
    </div>
  <% end %>

</div>

