GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated list of Google account email addresses permitted to sign in.
# Example: ALLOWED_EMAILS=alice@example.com,bob@example.com
ALLOWED_EMAILS=

# VAPID keys for Web Push notifications.
# Generate with:
#   bundle exec rails runner "key = WebPush.generate_key; puts \"VAPID_PUBLIC_KEY=#{key.public_key}\"; puts \"VAPID_PRIVATE_KEY=#{key.private_key}\""
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ReoLink camera snapshot capture.
# When a doorbell/motion webhook event is received, HomeAlert calls the
# camera's HTTP API directly (not through the ReoLink cloud) to grab a still
# image before the push notification is sent. Leave REOLINK_HOST blank to
# disable snapshot capture entirely — events will still be recorded and
# notified, just without a photo.
REOLINK_HOST=
REOLINK_USERNAME=
REOLINK_PASSWORD=
REOLINK_CHANNEL=0
# Set to "https" only if your camera's firmware exposes an HTTPS listener on
# its CGI port. Most ReoLink camera firmware only supports plain HTTP here,
# which means the password travels in cleartext over the local network on
# every snapshot request — keep the camera on a trusted/isolated network.
REOLINK_SCHEME=http

# How many days to keep captured snapshots before SnapshotRetentionJob purges
# them. Set to 0 to keep snapshots indefinitely.
SNAPSHOT_RETENTION_DAYS=30

