GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated list of Google account email addresses permitted to sign in.
# Example: ALLOWED_EMAILS=alice@example.com,bob@example.com
ALLOWED_EMAILS=

# VAPID keys for Web Push notifications.
# Generate with: bundle exec rails runner "puts WebPush.generate_key_pair.inspect"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
